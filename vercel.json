{
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "desafiogiro.giromotosbikes.com.br"
        }
      ],
      "destination": "/mudanca-de-endereco.html"
    },
    {
      "source": "/desafios/50tao",
      "destination": "/landing/50tao.html"
    },
    {
      "source": "/desafios/50tao/",
      "destination": "/landing/50tao.html"
    },
    {
      "source": "/desafios/:campanha",
      "destination": "/landing/index.html?campanha=:campanha"
    },
    {
      "source": "/desafios/:campanha/",
      "destination": "/landing/index.html?campanha=:campanha"
    }
  ],
  "headers": [
    {
      "source": "/landing/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
